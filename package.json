{
  "name": "dock-editor",
  "version": "0.1.0",
  "description": "File viewer plugin for the dock-files file domain: registers the 'editor' file viewer (default) and the matching editor-area view. Renders a file's text content (read-only in Phase 1) through its own /dock-editor/fs.read host route.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.mjs",
    "check": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "dock": ">=0.1.0",
    "dock-files": ">=0.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dock": {
      "optional": true
    },
    "dock-files": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "dock": "link:/home/zero/AgentX/plugins/dock",
    "dock-files": "link:/home/zero/AgentX/plugins/dock-files",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
